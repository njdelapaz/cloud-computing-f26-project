# QoS
modify QOS set normal Priority=0
# cluster
add cluster Name=gpu24 Fairshare=1 QOS=normal
# accounts
add account name=account0 Fairshare=100
add account name=account1 Fairshare=100
add account name=account2 Fairshare=100
add account name=account3 Fairshare=100
# admin
add user name=admin DefaultAccount=account0 MaxSubmitJobs=10000 AdminLevel=Administrator
# users
add user name=user1 DefaultAccount=account1 MaxSubmitJobs=10000
add user name=user2 DefaultAccount=account1 MaxSubmitJobs=10000
add user name=user3 DefaultAccount=account2 MaxSubmitJobs=10000
add user name=user4 DefaultAccount=account2 MaxSubmitJobs=10000
add user name=user5 DefaultAccount=account3 MaxSubmitJobs=10000
modify user set qoslevel="normal"
list associations format=Account,Cluster,User,Fairshare tree withd
