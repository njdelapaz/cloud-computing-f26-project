+
+/* ver_0.2: one _slurmctld_background call, measured and (virtual clock) charged */
+static void _sim_background(void)
+{
+	int64_t m0 = sim_mono_utime();
+	_slurmctld_background(NULL);
+	int64_t real = sim_mono_utime() - m0;
+	int64_t charged = sim_virtual_clock ? slurm_sim_conf->background_cost : 0;
+	sim_charge(charged);
+	sim_cost_log("background", 0, real, charged);
+}
+
+/* ver_0.2: measured and (virtual clock) charged cost of one processed event; handled is 0
+ * for a completion event that was ignored because its job had already ended */
+static void _sim_event_cost(int type, int64_t real, int handled)
+{
+	const char *kind;
+	int64_t cost = 0;
+	switch (type) {
+	case SIM_SUBMIT_BATCH_JOB:      kind = "submit";   cost = slurm_sim_conf->submit_cost; break;
+	case SIM_COMPLETE_BATCH_SCRIPT: kind = handled ? "complete" : "complete_ignored";
+	                                cost = handled ? slurm_sim_conf->complete_cost : 0; break;
+	case SIM_EPILOG_COMPLETE:       kind = handled ? "epilog" : "epilog_ignored";
