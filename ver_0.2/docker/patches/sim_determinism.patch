+/*
+ * ver_0.2 virtual clock (docker/patches/sim_determinism.patch).
+ * With ClockMode=virtual, slurmctld's simulated time no longer follows real time.
+ * It moves only when the event loop skips ahead, when the main thread sleeps or waits,
+ * and by the fixed costs set in sim.conf, so identical inputs give identical runs.
+ * Only the main thread moves it; other threads only read it.
+ */
+int sim_virtual_clock = 0;
+int sim_is_slurmctld = 0;
+static int64_t sim_vclock_utime = 0;
+
+static inline int64_t _vclock_get(void)
+{
+	return __atomic_load_n(&sim_vclock_utime, __ATOMIC_ACQUIRE);
+}
+
