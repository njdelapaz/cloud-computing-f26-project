+/*
+ * ver_0.2: completion events carry the job id. A job killed at its time limit gets a second
+ * completion event, and the first one used to point at the job's sim_job record, which is freed
+ * when the job ends; when it fired, it completed whichever job had reused that memory. An event
+ * whose job is no longer active is now ignored.
+ */
+/* return 0 when the event was ignored */
+static int sim_complete_job_event(uint32_t job_id)
+{
+	if (sim_find_active_sim_job(job_id) == NULL) {
+		debug("sim: completion event for JobId=%u ignored, the job already ended", job_id);
+		return 0;
+	}
+	sim_complete_job(job_id);
+	return 1;
+}
+
+static int sim_epilog_complete_event(uint32_t job_id)
+{
+	if (sim_find_active_sim_job(job_id) == NULL) {
+		debug("sim: epilog event for JobId=%u ignored, the job already ended", job_id);
+		return 0;
+	}
+	sim_rpc_epilog_complete(job_id);
+	return 1;
+}
+
 // 0 means such event currently do not occur
