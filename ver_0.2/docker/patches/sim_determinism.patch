+/* real elapsed time in microseconds (CLOCK_MONOTONIC); used only to measure costs */
+int64_t sim_mono_utime(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (int64_t) ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
+}
+
+/* keep the clock shared with slurmdbd close to ours, never moving it backwards */
+static void _vclock_publish(int64_t t)
+{
+	struct timeval cur_real_time;
+	__real_gettimeofday(&cur_real_time, NULL);
+	int64_t cur_real_utime = (int64_t) (cur_real_time.tv_sec) * (int64_t) 1000000 + (int64_t) (cur_real_time.tv_usec);
+	int64_t shared_now = cur_real_utime + *sim_timeval_shift +
+		(int64_t)((*sim_timeval_scale - 1.0) * cur_real_utime);
+	if (t > shared_now) {
+		*sim_timeval_scale = 1.0;
+		*sim_timeval_shift = t - cur_real_utime;
+	}
+}
+
+/* move the virtual clock forward to t (never backwards) */
+void sim_vclock_set(int64_t t)
+{
+	if (t > _vclock_get()) {
+		__atomic_store_n(&sim_vclock_utime, t, __ATOMIC_RELEASE);
+		_vclock_publish(t);
+	}
+}
+
+/* charge a fixed simulated cost; no-op in real mode */
+void sim_charge(int64_t usec)
+{
+	if (sim_virtual_clock && usec > 0)
+		sim_vclock_set(_vclock_get() + usec);
+}
+
+void sim_charge_sched_job(void)
+{
+	sim_charge(slurm_sim_conf->sched_job_cost);
+}
+
+/* CostLog: kind,sim_utime,n,real_usec,charged_usec,mono_usec (CLOCK_MONOTONIC when logged) */
+void sim_cost_log(const char *kind, int64_t n, int64_t real_usec, int64_t charged_usec)
+{
+	static FILE *f = NULL;
+	static int failed = 0;
+	if (!sim_is_slurmctld || !slurm_sim_conf || !slurm_sim_conf->cost_log || failed)
+		return;
+	if (f == NULL) {
+		f = fopen(slurm_sim_conf->cost_log, "w");
+		if (f == NULL) {
+			failed = 1;
+			error("sim: can not open CostLog %s", slurm_sim_conf->cost_log);
+			return;
+		}
+		/* line-buffered: slurmctld's exit doesn't flush stdio */
+		setvbuf(f, NULL, _IOLBF, 0);
+		fprintf(f, "kind,sim_utime,n,real_usec,charged_usec,mono_usec\n");
+	}
+	fprintf(f, "%s,%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "\n",
+		kind, get_sim_utime(), n, real_usec, charged_usec, sim_mono_utime());
+}
+
+/* backfill cycle accounting: real time excludes the time spent yielding */
+static int64_t bf_cycle_mono_start = 0;
+static int64_t bf_yield_mono_start = 0;
+static int64_t bf_yield_mono_total = 0;
+
+void sim_bf_cycle_begin(void)
+{
+	bf_cycle_mono_start = sim_mono_utime();
+	bf_yield_mono_total = 0;
+	sim_charge(slurm_sim_conf->bf_cycle_cost);
+}
+
+void sim_bf_yield_begin(void)
+{
+	bf_yield_mono_start = sim_mono_utime();
+}
+
+void sim_bf_yield_end(void)
+{
+	bf_yield_mono_total += sim_mono_utime() - bf_yield_mono_start;
+}
+
+static void _bf_cycle_end(int n)
+{
+	int64_t real = sim_mono_utime() - bf_cycle_mono_start - bf_yield_mono_total;
+	int64_t charged = sim_virtual_clock ?
+		slurm_sim_conf->bf_cycle_cost + (int64_t) n * slurm_sim_conf->bf_job_cost : 0;
+	sim_cost_log("bf", n, real, charged);
+}
